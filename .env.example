# ── Telegram ────────────────────────────────────────────────────────────
# Токен от @BotFather
BOT_TOKEN=
# Имя бота без @ — нужно для ссылок-приглашений
BOT_USERNAME=
# Случайная строка в пути вебхука: /tg/webhook/<секрет>. Только для прода.
WEBHOOK_SECRET=
# Публичный адрес, где стоит приложение. Пусто = режим polling.
PUBLIC_URL=

# ── Секреты ─────────────────────────────────────────────────────────────
# HMAC для ссылок-приглашений и анонимных голосований.
# Намеренно НЕ равен BOT_TOKEN: утечка токена не должна раскрывать,
# кто как проголосовал. Сгенерировать: python -c "import secrets;print(secrets.token_hex(32))"
APP_SECRET=

# ── Класс ───────────────────────────────────────────────────────────────
CLASS_NAME=1 «В»
CLASS_SCHOOL=Школа №101
CLASS_TZ=Asia/Tashkent
CLASS_CURRENCY=UZS
# Латинский префикс кодов для сверки переводов: 1V-01, 1V-02 ...
CLASS_CODE=1V

# Ваш Telegram user id — первому /start выдаст роли председателя и админа.
# Узнать: напишите боту и посмотрите лог, либо @userinfobot
BOOTSTRAP_CHAIR_TG_ID=

# ── Правила ─────────────────────────────────────────────────────────────
# Расходы до этой суммы утверждаются без второй подписи
EXPENSE_AUTO_APPROVE_UZS=100000
# За сколько дней до срока напомнить о взносе (второе напоминание — в день срока)
REMIND_DAYS_BEFORE=3

# ── Домен и Mini App (см. docs/DEPLOY.md, раздел «Домен») ──────────────
# Подключение к сети Caddy от Spreadis. Раскомментировать вместе с доменом.
# COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
# PROXY_NETWORK=spreadis-deploy_spreadis

# ── Локальная разработка ────────────────────────────────────────────────
# НЕ задавать на сервере (там они и так игнорируются).
# Вход в Mini App из обычного браузера: tg_user_id, под которым пускать.
# DEV_AUTH_TG_ID=
# 0 — не опрашивать Telegram, если этот же бот уже работает на сервере.
# BOT_POLLING=1

# ── Служебное ───────────────────────────────────────────────────────────
DB_PATH=data/school.db
LOG_DIR=data/logs
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080
